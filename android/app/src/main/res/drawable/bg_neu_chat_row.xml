<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Outer Ambient Shadow -->
    <item
        android:top="4.5dp"
        android:left="4.5dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_diffuse_outer" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- 2. Mid Diffuse Shadow -->
    <item
        android:top="3dp"
        android:left="3dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_diffuse_mid" />
            <corners android:radius="23dp" />
        </shape>
    </item>

    <!-- 3. Top-Left Pure White Highlight Glow -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="4.5dp"
        android:bottom="4.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_light_shadow" />
            <corners android:radius="23dp" />
        </shape>
    </item>

    <!-- 4. Main Surface Body (Subtle 4dp projection) -->
    <item
        android:top="1.5dp"
        android:left="1.5dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_surface" />
            <stroke android:width="0.8dp" android:color="#FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
