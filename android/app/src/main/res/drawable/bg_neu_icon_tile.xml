<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom-right soft shadow -->
    <item android:top="2dp" android:left="2dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_dark_shadow" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Top-left soft highlight -->
    <item android:top="0dp" android:left="0dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_light_shadow" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Main surface -->
    <item android:top="1.5dp" android:left="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_surface" />
            <stroke android:width="0.5dp" android:color="#FFFFFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
