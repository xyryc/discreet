<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Outer Ambient Shadow -->
    <item
        android:top="3.5dp"
        android:left="3.5dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_diffuse_outer" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- 2. Mid Diffuse Shadow -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_diffuse_mid" />
            <corners android:radius="17dp" />
        </shape>
    </item>

    <!-- 3. Top-Left Pure White Highlight Glow -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="3.5dp"
        android:bottom="3.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_light_shadow" />
            <corners android:radius="17dp" />
        </shape>
    </item>

    <!-- 4. Main Surface Body (Subtle 3dp projection) -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_surface" />
            <stroke android:width="0.8dp" android:color="#FFFFFF" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
