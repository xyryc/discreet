<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom-right soft shadow -->
    <item android:top="2.5dp" android:left="2.5dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#334F46E5" />
            <corners
                android:topLeftRadius="18dp"
                android:topRightRadius="4dp"
                android:bottomLeftRadius="18dp"
                android:bottomRightRadius="18dp" />
        </shape>
    </item>

    <!-- Main surface -->
    <item android:top="1dp" android:left="1dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_accent" />
            <stroke android:width="0.5dp" android:color="#818CF8" />
            <corners
                android:topLeftRadius="17dp"
                android:topRightRadius="4dp"
                android:bottomLeftRadius="17dp"
                android:bottomRightRadius="17dp" />
        </shape>
    </item>
</layer-list>