<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom-right soft shadow -->
    <item android:top="3dp" android:left="3dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="@color/neu_dark_shadow" />
        </shape>
    </item>
    <!-- Top-left highlight -->
    <item android:top="0dp" android:left="0dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/neu_light_shadow" />
        </shape>
    </item>
    <!-- Outer bezel ring -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/neu_surface" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
