<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Inset background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_inset_shadow" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Soft tinted core -->
    <item android:top="1.5dp" android:left="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_accent_light" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
