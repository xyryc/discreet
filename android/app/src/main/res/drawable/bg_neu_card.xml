<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Outer Ambient Shadow (5dp offset) -->
    <item
        android:top="5dp"
        android:left="5dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_diffuse_outer" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- 2. Mid Diffuse Shadow (3.5dp offset) -->
    <item
        android:top="3.5dp"
        android:left="3.5dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_diffuse_mid" />
            <corners android:radius="25dp" />
        </shape>
    </item>

    <!-- 3. Core Gentle Shadow (2dp offset) -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_dark_shadow" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- 4. Top-Left Pure White Light Glow (5dp highlight spread) -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_light_shadow" />
            <corners android:radius="25dp" />
        </shape>
    </item>

    <!-- 5. Main Card Surface (Subtly anchored, balanced 4.5dp projection) -->
    <item
        android:top="1.5dp"
        android:left="1.5dp"
        android:right="4.5dp"
        android:bottom="4.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_surface" />
            <stroke android:width="0.8dp" android:color="#FFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</layer-list>
