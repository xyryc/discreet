<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Bottom-Right Soft Ambient Shadow -->
    <item android:top="2dp" android:left="2dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_dark_shadow" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- 2. Top-Left Soft Highlight Glow -->
    <item android:top="0dp" android:left="0dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_light_shadow" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- 3. Main Base Surface (Matches Background for True Extruded 3D Effect) -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_surface" />
            <stroke android:width="1dp" android:color="#F8FAFC" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
