<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom-right soft shadow -->
    <item android:top="2.5dp" android:left="2.5dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_diffuse_mid" />
            <corners
                android:topLeftRadius="4dp"
                android:topRightRadius="18dp"
                android:bottomLeftRadius="18dp"
                android:bottomRightRadius="18dp" />
        </shape>
    </item>

    <!-- Top-left white highlight -->
    <item android:top="0dp" android:left="0dp" android:right="2.5dp" android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_light_shadow" />
            <corners
                android:topLeftRadius="4dp"
                android:topRightRadius="18dp"
                android:bottomLeftRadius="18dp"
                android:bottomRightRadius="18dp" />
        </shape>
    </item>

    <!-- Main surface -->
    <item android:top="1.5dp" android:left="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="0.5dp" android:color="#F1F5F9" />
            <corners
                android:topLeftRadius="4dp"
                android:topRightRadius="17dp"
                android:bottomLeftRadius="17dp"
                android:bottomRightRadius="17dp" />
        </shape>
    </item>
</layer-list>