<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="NeumorphCardView">
        <attr name="neu_corner_radius" format="dimension" />
        <attr name="neu_shadow_distance" format="dimension" />
        <attr name="neu_shadow_blur" format="dimension" />
        <attr name="neu_dark_shadow_color" format="color" />
        <attr name="neu_light_shadow_color" format="color" />
        <attr name="neu_background_color" format="color" />
        <attr name="neu_stroke_color" format="color" />
        <attr name="neu_stroke_width" format="dimension" />
        <attr name="neu_shape_type" format="enum">
            <enum name="flat" value="0" />
            <enum name="pressed" value="1" />
        </attr>
    </declare-styleable>
</resources>
