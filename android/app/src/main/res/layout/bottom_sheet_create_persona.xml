<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/neu_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_neu_chip_inactive" />

    <!-- Avatar Bezel -->
    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_neu_avatar_ring"
        android:padding="5dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_persona_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_person"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Choose Your Persona"
        android:textColor="@color/neu_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:text="This is how contacts will see you on Discreet"
        android:textColor="@color/neu_text_secondary"
        android:textSize="13sp" />

    <!-- Recessed Display Name Input Pill -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_neu_search_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_baseline_person_24"
                app:tint="@color/neu_accent" />

            <EditText
                android:id="@+id/et_persona_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@null"
                android:hint="Enter your display name..."
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"
                android:textColor="@color/neu_text_primary"
                android:textColorHint="@color/neu_text_muted"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Auto-Generated Cryptographic Handle Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_neu_chip_inactive"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_baseline_vpn_key_24"
            app:tint="@color/neu_accent" />

        <TextView
            android:id="@+id/tv_crypto_handle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:text="@discreet/user_7f3a"
            android:textColor="@color/neu_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Start Messaging Button -->
    <FrameLayout
        android:id="@+id/btn_enter_discreet"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_neu_button_selector"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:text="Launch Discreet"
            android:textColor="@color/neu_accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

</LinearLayout>
