<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/neu_background"
        tools:context=".view.auth.SetUserInfoActivity">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/btn_next_container"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="48dp"
                android:paddingBottom="24dp">

                <!-- Header Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Set Up Your Profile"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Choose your display name and an optional encrypted avatar"
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="13sp" />

                <!-- Avatar with Bezel Ring -->
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="32dp">

                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_neu_avatar_ring"
                        android:padding="5dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/image_profile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/icon_person"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:background="@drawable/bg_neu_button_selector">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_baseline_camera_alt_24"
                            app:tint="@color/neu_accent" />
                    </FrameLayout>
                </RelativeLayout>

                <!-- Username Input Card (NeumorphCardView) -->
                <com.example.chatapplication.common.view.NeumorphCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:neu_corner_radius="24dp"
                    app:neu_shadow_blur="9dp"
                    app:neu_shadow_distance="4.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Display Name"
                            android:textColor="@color/neu_text_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_neu_search_bar"
                            android:paddingHorizontal="14dp">

                            <EditText
                                android:id="@+id/ed_name"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:fontFamily="sans-serif"
                                android:hint="Enter your nickname"
                                android:imeOptions="actionDone"
                                android:inputType="textCapWords"
                                android:maxLines="1"
                                android:textColor="@color/neu_text_primary"
                                android:textColorHint="@color/neu_text_muted"
                                android:textSize="15sp" />
                        </FrameLayout>
                    </LinearLayout>
                </com.example.chatapplication.common.view.NeumorphCardView>

            </LinearLayout>
        </ScrollView>

        <!-- Continue Button Dock -->
        <FrameLayout
            android:id="@+id/btn_next_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/neu_background"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp"
            android:paddingTop="8dp">

            <FrameLayout
                android:id="@+id/btn_next"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_neu_chip_active"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:text="Continue to Discreet"
                    android:textColor="@color/neu_text_on_accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>

    </RelativeLayout>
</layout>