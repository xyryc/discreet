<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/neu_background">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="48dp"
                android:paddingBottom="36dp">

                <!-- 1. HEADER BRANDING -->
                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_neu_icon_tile">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_discreet_logo" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_auth_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Welcome Back"
                    android:textColor="@color/neu_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_auth_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp"
                    android:fontFamily="sans-serif"
                    android:text="Sign in to access your encrypted conversations"
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="13sp" />

                <!-- 2. SEGMENTED TAB SWITCHER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_neu_search_bar"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <FrameLayout
                        android:id="@+id/tab_sign_in"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_neu_chip_active"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tv_tab_sign_in"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="sans-serif-medium"
                            android:text="Sign In"
                            android:textColor="@color/neu_text_on_accent"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/tab_register"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tv_tab_register"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="sans-serif-medium"
                            android:text="Create Account"
                            android:textColor="@color/neu_text_secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>

                <!-- 3. NEUMORPHIC INPUT CARD -->
                <com.example.chatapplication.common.view.NeumorphCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:neu_corner_radius="28dp"
                    app:neu_shadow_blur="10dp"
                    app:neu_shadow_distance="5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <!-- Full Name Input (Register Only) -->
                        <LinearLayout
                            android:id="@+id/layout_name_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Display Name"
                                android:textColor="@color/neu_text_primary"
                                android:textSize="12sp" />

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_neu_search_bar">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="16dp">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:src="@drawable/ic_baseline_person_24"
                                        app:tint="@color/neu_accent" />

                                    <EditText
                                        android:id="@+id/et_name"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="12dp"
                                        android:background="@null"
                                        android:hint="Your display name"
                                        android:inputType="textPersonName|textCapWords"
                                        android:maxLines="1"
                                        android:textColor="@color/neu_text_primary"
                                        android:textColorHint="@color/neu_text_muted"
                                        android:textSize="14sp" />
                                </LinearLayout>
                            </FrameLayout>
                        </LinearLayout>

                        <!-- Email Input -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Email Address"
                            android:textColor="@color/neu_text_primary"
                            android:textSize="12sp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_neu_search_bar">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="16dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_baseline_email_24"
                                    app:tint="@color/neu_accent" />

                                <EditText
                                    android:id="@+id/et_email"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:background="@null"
                                    android:hint="name@domain.com"
                                    android:inputType="textEmailAddress"
                                    android:maxLines="1"
                                    android:textColor="@color/neu_text_primary"
                                    android:textColorHint="@color/neu_text_muted"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- Password Input -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Password"
                            android:textColor="@color/neu_text_primary"
                            android:textSize="12sp" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginBottom="20dp"
                            android:background="@drawable/bg_neu_search_bar">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="16dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_baseline_lock_24"
                                    app:tint="@color/neu_accent" />

                                <EditText
                                    android:id="@+id/et_password"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:background="@null"
                                    android:hint="Min. 6 characters"
                                    android:inputType="textPassword"
                                    android:maxLines="1"
                                    android:textColor="@color/neu_text_primary"
                                    android:textColorHint="@color/neu_text_muted"
                                    android:textSize="14sp" />

                                <ImageView
                                    android:id="@+id/btn_toggle_password"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:src="@drawable/ic_baseline_visibility_24"
                                    app:tint="@color/neu_text_muted" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- Submit Button -->
                        <FrameLayout
                            android:id="@+id/btn_submit"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_neu_button_selector"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tv_btn_submit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="sans-serif-medium"
                                android:text="Sign In to Discreet"
                                android:textColor="@color/neu_accent"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                    </LinearLayout>
                </com.example.chatapplication.common.view.NeumorphCardView>

                <!-- 4. GUEST / ANONYMOUS LINK -->
                <TextView
                    android:id="@+id/btn_guest_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:padding="8dp"
                    android:text="Or continue as Anonymous Guest"
                    android:textColor="@color/neu_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <FrameLayout
            android:id="@+id/layout_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#60F1F4F9"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/neu_accent" />
        </FrameLayout>

    </RelativeLayout>
</layout>
